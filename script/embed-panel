#!/usr/bin/env bash
#
# Embed the files in Panel/dist into a Swift source as a dictionary of base64 strings,
# so the plugin needs no resource bundle.
#
# Usage:
#   script/embed-panel
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
src="$root/Panel/dist"
out="$root/Sources/NectoMapLocalPlugin/EmbeddedPanel.swift"
[ -f "$src/manifest.json" ] || { echo "no $src/manifest.json — build the panel first with script/build-panel"; exit 1; }
{
  echo "//"
  echo "// Copyright (c) 2026 necto-map-local-plugin contributors"
  echo "//"
  echo
  echo "#if MAP_LOCAL_ENABLED"
  echo "// Generated by script/embed-panel. Do not edit by hand."
  echo "enum EmbeddedPanel {"
  echo "    static let files: [String: String] = ["
  (cd "$src" && find . -type f ! -name '.DS_Store' | LC_ALL=C sort) | while read -r rel; do
    rel="${rel#./}"
    b64=$(base64 -i "$src/$rel" | tr -d '\n')
    echo "        \"$rel\": \"$b64\","
  done
  echo "    ]"
  echo "}"
  echo "#endif"
} > "$out"
echo "embedded $(command grep -c '": "' "$out") files → $out"
