{
  "cases": [
    { "name": "the first enabled rule", "request": { "method": "GET", "url": "https://maplocal.invalid/a/1" },
      "rules": [ { "id": "r1", "enabled": true, "match": { "method": "GET", "path": "/a/{id}" }, "active": "ok", "responses": { "ok": { "status": 200 } } },
                 { "id": "r2", "enabled": true, "match": { "method": "GET", "path": "/a/1" }, "active": "ok", "responses": { "ok": { "status": 200 } } } ],
      "expect": "r1" },
    { "name": "skips a disabled rule", "request": { "method": "GET", "url": "https://maplocal.invalid/a/1" },
      "rules": [ { "id": "off", "enabled": false, "match": { "method": "GET", "path": "/a/{id}" }, "active": "ok", "responses": { "ok": { "status": 200 } } },
                 { "id": "on", "enabled": true, "match": { "method": "GET", "path": "/a/1" }, "active": "ok", "responses": { "ok": { "status": 200 } } } ],
      "expect": "on" },
    { "name": "skips a rule without an active response", "request": { "method": "GET", "url": "https://maplocal.invalid/a" },
      "rules": [ { "id": "broken", "enabled": true, "match": { "method": "GET", "path": "/a" }, "active": "missing", "responses": { "ok": { "status": 200 } } } ],
      "expect": null },
    { "name": "a + in the query is not a space", "request": { "method": "GET", "url": "https://maplocal.invalid/s?q=a+b" },
      "rules": [ { "id": "plus", "enabled": true, "match": { "method": "GET", "path": "/s", "query": { "q": "a+b" } }, "active": "ok", "responses": { "ok": { "status": 200 } } } ],
      "expect": "plus" },
    { "name": "a repeated query key takes the last value", "request": { "method": "GET", "url": "https://maplocal.invalid/s?p=1&p=2" },
      "rules": [ { "id": "first", "enabled": true, "match": { "method": "GET", "path": "/s", "query": { "p": "1" } }, "active": "ok", "responses": { "ok": { "status": 200 } } },
                 { "id": "last", "enabled": true, "match": { "method": "GET", "path": "/s", "query": { "p": "2" } }, "active": "ok", "responses": { "ok": { "status": 200 } } } ],
      "expect": "last" },
    { "name": "{id} matches any segment", "request": { "method": "GET", "url": "https://maplocal.invalid/devices/summary" },
      "rules": [ { "id": "tmpl", "enabled": true, "match": { "method": "GET", "path": "/devices/{id}" }, "active": "ok", "responses": { "ok": { "status": 200 } } } ],
      "expect": "tmpl" },
    { "name": "a different host does not match", "request": { "method": "GET", "url": "https://other.invalid/a" },
      "rules": [ { "id": "h", "enabled": true, "match": { "method": "GET", "host": "maplocal.invalid", "path": "/a" }, "active": "ok", "responses": { "ok": { "status": 200 } } } ],
      "expect": null },
    { "name": "a different method does not match", "request": { "method": "POST", "url": "https://maplocal.invalid/a" },
      "rules": [ { "id": "g", "enabled": true, "match": { "method": "GET", "path": "/a" }, "active": "ok", "responses": { "ok": { "status": 200 } } } ],
      "expect": null },
    {"name": "only the earlier entry with the same id applies", "request": {"method": "GET", "url": "https://maplocal.invalid/a"}, "rules": [{"id": "dup", "enabled": true, "match": {"method": "GET", "path": "/b"}, "active": "ok", "responses": {"ok": {"status": 200}}}, {"id": "dup", "enabled": true, "match": {"method": "GET", "path": "/a"}, "active": "ok", "responses": {"ok": {"status": 200}}}], "expect": null},
    {"name": "chooses the earlier entry with the same id when it matches", "request": {"method": "GET", "url": "https://maplocal.invalid/a"}, "rules": [{"id": "dup", "enabled": true, "match": {"method": "GET", "path": "/a"}, "active": "ok", "responses": {"ok": {"status": 200}}}, {"id": "dup", "enabled": true, "match": {"method": "GET", "path": "/b"}, "active": "ok", "responses": {"ok": {"status": 200}}}], "expect": "dup"},
    {"name": "skips an unreadable entry and chooses the rule after it", "request": {"method": "GET", "url": "https://maplocal.invalid/a"}, "rules": [{"id": "bad", "match": null, "active": "ok", "responses": {"ok": {"status": 200}}}, {"id": "good", "enabled": true, "match": {"method": "GET", "path": "/a"}, "active": "ok", "responses": {"ok": {"status": 200}}}], "expect": "good"},
    {"name": "an entry whose path does not start with / is not a rule", "request": {"method": "GET", "url": "https://maplocal.invalid/a"}, "rules": [{"id": "bad", "enabled": true, "match": {"method": "GET", "path": "a"}, "active": "ok", "responses": {"ok": {"status": 200}}}, {"id": "good", "enabled": true, "match": {"method": "GET", "path": "/a"}, "active": "ok", "responses": {"ok": {"status": 200}}}], "expect": "good"},
    {"name": "a rule's lowercase method is read as uppercase and matches", "request": {"method": "GET", "url": "https://maplocal.invalid/a"}, "rules": [{"id": "lower", "enabled": true, "match": {"method": "get", "path": "/a"}, "active": "ok", "responses": {"ok": {"status": 200}}}], "expect": "lower"},
    {"name": "a query-condition rule after a generic rule wins", "request": {"method": "GET", "url": "https://maplocal.invalid/api/sites?page=2"}, "rules": [{"id": "generic", "enabled": true, "match": {"method": "GET", "path": "/api/sites"}, "active": "ok", "responses": {"ok": {"status": 200}}}, {"id": "page2", "enabled": true, "match": {"method": "GET", "path": "/api/sites", "query": {"page": "2"}}, "active": "ok", "responses": {"ok": {"status": 200}}}], "expect": "page2"},
    {"name": "a request without a query passes the earlier query-condition rule and goes to the generic rule", "request": {"method": "GET", "url": "https://maplocal.invalid/api/sites"}, "rules": [{"id": "page2", "enabled": true, "match": {"method": "GET", "path": "/api/sites", "query": {"page": "2"}}, "active": "ok", "responses": {"ok": {"status": 200}}}, {"id": "generic", "enabled": true, "match": {"method": "GET", "path": "/api/sites"}, "active": "ok", "responses": {"ok": {"status": 200}}}], "expect": "generic"},
    {"name": "list order decides between equal numbers of query conditions", "request": {"method": "GET", "url": "https://maplocal.invalid/api/sites?page=2&size=10"}, "rules": [{"id": "generic", "enabled": true, "match": {"method": "GET", "path": "/api/sites"}, "active": "ok", "responses": {"ok": {"status": 200}}}, {"id": "page", "enabled": true, "match": {"method": "GET", "path": "/api/sites", "query": {"page": "2"}}, "active": "ok", "responses": {"ok": {"status": 200}}}, {"id": "size", "enabled": true, "match": {"method": "GET", "path": "/api/sites", "query": {"size": "10"}}, "active": "ok", "responses": {"ok": {"status": 200}}}], "expect": "page"},
    {"name": "the rule with more conditions wins", "request": {"method": "GET", "url": "https://maplocal.invalid/api/sites?page=2&size=10"}, "rules": [{"id": "page", "enabled": true, "match": {"method": "GET", "path": "/api/sites", "query": {"page": "2"}}, "active": "ok", "responses": {"ok": {"status": 200}}}, {"id": "both", "enabled": true, "match": {"method": "GET", "path": "/api/sites", "query": {"page": "2", "size": "10"}}, "active": "ok", "responses": {"ok": {"status": 200}}}], "expect": "both"},
    {"name": "a disabled query-condition rule does not beat a generic rule", "request": {"method": "GET", "url": "https://maplocal.invalid/api/sites?page=2"}, "rules": [{"id": "generic", "enabled": true, "match": {"method": "GET", "path": "/api/sites"}, "active": "ok", "responses": {"ok": {"status": 200}}}, {"id": "page2", "enabled": false, "match": {"method": "GET", "path": "/api/sites", "query": {"page": "2"}}, "active": "ok", "responses": {"ok": {"status": 200}}}], "expect": "generic"},
    {"name": "a query-condition rule without an active response does not beat a generic rule", "request": {"method": "GET", "url": "https://maplocal.invalid/api/sites?page=2"}, "rules": [{"id": "generic", "enabled": true, "match": {"method": "GET", "path": "/api/sites"}, "active": "ok", "responses": {"ok": {"status": 200}}}, {"id": "page2", "enabled": true, "match": {"method": "GET", "path": "/api/sites", "query": {"page": "2"}}, "active": "missing", "responses": {"ok": {"status": 200}}}], "expect": "generic"},
    {"name": "a query condition that is not an object (text) is not a rule", "request": {"method": "GET", "url": "https://maplocal.invalid/api/sites?page=1"}, "rules": [{"id": "bad", "enabled": true, "match": {"method": "GET", "path": "/api/sites", "query": "page=2"}, "active": "ok", "responses": {"ok": {"status": 200}}}, {"id": "generic", "enabled": true, "match": {"method": "GET", "path": "/api/sites"}, "active": "ok", "responses": {"ok": {"status": 200}}}], "expect": "generic"},
    {"name": "a query condition that is not an object (null) is not a rule", "request": {"method": "GET", "url": "https://maplocal.invalid/api/sites?page=1"}, "rules": [{"id": "bad", "enabled": true, "match": {"method": "GET", "path": "/api/sites", "query": null}, "active": "ok", "responses": {"ok": {"status": 200}}}, {"id": "generic", "enabled": true, "match": {"method": "GET", "path": "/api/sites"}, "active": "ok", "responses": {"ok": {"status": 200}}}], "expect": "generic"},
    {"name": "a query condition that is not an object (array) is not a rule", "request": {"method": "GET", "url": "https://maplocal.invalid/api/sites?page=1"}, "rules": [{"id": "bad", "enabled": true, "match": {"method": "GET", "path": "/api/sites", "query": [["page", "2"]]}, "active": "ok", "responses": {"ok": {"status": 200}}}, {"id": "generic", "enabled": true, "match": {"method": "GET", "path": "/api/sites"}, "active": "ok", "responses": {"ok": {"status": 200}}}], "expect": "generic"},
    {"name": "response headers that are not an object (null) are not a rule", "request": {"method": "GET", "url": "https://maplocal.invalid/api/sites"}, "rules": [{"id": "bad", "enabled": true, "match": {"method": "GET", "path": "/api/sites"}, "active": "ok", "responses": {"ok": {"status": 200, "headers": null}}}], "expect": null},
    {"name": "response headers that are not an object (array) are not a rule", "request": {"method": "GET", "url": "https://maplocal.invalid/api/sites"}, "rules": [{"id": "bad", "enabled": true, "match": {"method": "GET", "path": "/api/sites"}, "active": "ok", "responses": {"ok": {"status": 200, "headers": ["x"]}}}], "expect": null},
    {"name": "an encoded rule path matches an encoded request path", "request": {"method": "GET", "url": "https://maplocal.invalid/x%20y"}, "rules": [{"id": "encoded", "enabled": true, "match": {"method": "GET", "path": "/x%20y"}, "active": "ok", "responses": {"ok": {"status": 200}}}], "expect": "encoded"},
    {"name": "a rule path with a raw space is not a rule", "request": {"method": "GET", "url": "https://maplocal.invalid/x%20y"}, "rules": [{"id": "raw", "enabled": true, "match": {"method": "GET", "path": "/x y/{id}"}, "active": "ok", "responses": {"ok": {"status": 200}}}, {"id": "encoded", "enabled": true, "match": {"method": "GET", "path": "/x%20y"}, "active": "ok", "responses": {"ok": {"status": 200}}}], "expect": "encoded"},
    {"name": "encoded Korean matches a request to a Korean path", "request": {"method": "GET", "url": "https://maplocal.invalid/%EA%B2%80%EC%83%89"}, "rules": [{"id": "raw", "enabled": true, "match": {"method": "GET", "path": "/검색"}, "active": "ok", "responses": {"ok": {"status": 200}}}, {"id": "encoded", "enabled": true, "match": {"method": "GET", "path": "/%EA%B2%80%EC%83%89"}, "active": "ok", "responses": {"ok": {"status": 200}}}], "expect": "encoded"},
    {"name": "sub-delimiters, colon and at sign match as written", "request": {"method": "GET", "url": "https://maplocal.invalid/@me/a:b;v=1"}, "rules": [{"id": "subdelims", "enabled": true, "match": {"method": "GET", "path": "/@me/a:b;v=1"}, "active": "ok", "responses": {"ok": {"status": 200}}}], "expect": "subdelims"}
  ]
}
