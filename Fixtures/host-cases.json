{
  "cases": [
    {"name": "unchanged", "raw": "prod.invalid", "expect": "prod.invalid"},
    {"name": "lowercased", "raw": "PROD.invalid", "expect": "prod.invalid"},
    {"name": "strips the scheme, port and path", "raw": "https://prod.invalid:443/", "expect": "prod.invalid"},
    {"name": "strips the scheme, port, path and query", "raw": "http://api.example.com:8080/v1/x?y=1", "expect": "api.example.com"},
    {"name": "strips a numeric port", "raw": "prod.invalid:8443", "expect": "prod.invalid"},
    {"name": "strips an empty port", "raw": "prod.invalid:", "expect": "prod.invalid"},
    {"name": "one trailing dot", "raw": "prod.invalid.", "expect": "prod.invalid"},
    {"name": "several trailing dots", "raw": "prod.invalid...", "expect": "prod.invalid"},
    {"name": "trims surrounding whitespace", "raw": "  https://Api.Example.com:8443/v1  ", "expect": "api.example.com"},
    {"name": "trims tabs", "raw": "\tapi.example.com\t", "expect": "api.example.com"},
    {"name": "trims non-breaking spaces (NBSP)", "raw": "\u00a0api.example.com\u00a0", "expect": "api.example.com"},
    {"name": "underscores, hyphens and digits", "raw": "dev_api-2.example.com", "expect": "dev_api-2.example.com"},
    {"name": "punycode stays unchanged", "raw": "xn--3e0b707e.kr", "expect": "xn--3e0b707e.kr"},
    {"name": "empty text", "raw": "", "expect": null},
    {"name": "whitespace only", "raw": "   ", "expect": null},
    {"name": "dots only", "raw": "...", "expect": null},
    {"name": "whitespace in the middle", "raw": "a b", "expect": null},
    {"name": "scheme only", "raw": "https://", "expect": null},
    {"name": "IPv6 brackets", "raw": "[::1]", "expect": null},
    {"name": "non-numeric port", "raw": "host:abc", "expect": null},
    {"name": "user info", "raw": "user@host.com", "expect": null},
    {"name": "exclamation mark", "raw": "a!b.com", "expect": null},
    {"name": "percent-encoding", "raw": "%ED%95%9C.kr", "expect": null},
    {"name": "port with non-ASCII digits", "raw": "ex.com:五", "expect": null},
    {"name": "port with non-ASCII digits (Arabic-Indic digits)", "raw": "ex.com:\u0663", "expect": null},
    {"name": "Unicode host", "raw": "한국.kr", "expect": "한국.kr", "panel": "punycode"},
    {"name": "decomposed é", "raw": "e\u0301x.com", "expect": "e\u0301x.com", "panel": "punycode"},
    {"name": "İ, which gains a combining dot when lowercased", "raw": "İstanbul.com", "expect": "i\u0307stanbul.com", "panel": "punycode"},
    {"name": "Devanagari", "raw": "हिन्दी.com", "expect": "हिन्दी.com", "panel": "punycode"},
    {"name": "full-width letters", "raw": "ＡＰＩ.com", "expect": "ａｐｉ.com", "panel": "punycode"}
  ]
}
